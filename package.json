{
  "name": "bookmark-atlas",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "bin": {
    "bookmark-atlas": "./src/cli.ts"
  },
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "sync:github": "node src/cli.ts sync github",
    "enrich:github": "node src/cli.ts enrich github-readmes",
    "import:x": "node src/cli.ts import x-json",
    "benchmark:retrieval": "node src/cli.ts benchmark retrieval",
    "snapshot:build": "node src/cli.ts snapshot build",
    "search": "node src/cli.ts search",
    "status": "node src/cli.ts status",
    "test": "node --test --test-concurrency=1",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.9.0"
  }
}
